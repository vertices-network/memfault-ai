# Memfault API Configuration
MEMFAULT_API_KEY=
MEMFAULT_ORG_SLUG=
MEMFAULT_PROJECT_SLUG=

# Anthropic API Configuration
AI_CLIENT=anthropic
AI_MODEL=claude-opus-4-6
ANTHROPIC_API_KEY=

# Source Code Configuration (Optional)
# Path to your local source code directory for enhanced analysis
SOURCE_CODE_PATH=/path/to/your/source/code

# Autonomous Fix Safety Gates (Optional)
# Defaults are non-mutating: fix commands generate reviewable drafts only.
MEMFAULT_AI_RUN_GIT_COMMANDS=false
MEMFAULT_AI_APPLY_FIXES=false
MEMFAULT_AI_BUILD_FIXES=true
MEMFAULT_AI_COMMIT_FIXES=false
